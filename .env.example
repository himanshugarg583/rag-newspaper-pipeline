# Application
APP_NAME=Newspaper RAG API
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Database (asyncpg driver; the app derives the sync URL automatically)
DATABASE_URL=postgresql+asyncpg://postgres:change_me@db:5432/newspaper_rag

POSTGRES_DB=newspaper_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT=60
EMBEDDING_BATCH_SIZE=64

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_TOP_K=10
HNSW_EF_SEARCH=100
# Optional cosine-distance cutoff; 0 disables filtering. Calibrate on real data.
RETRIEVAL_MAX_DISTANCE=0

# Chat
CHAT_HISTORY_MAX_MESSAGES=10

# Upload & OCR
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/storage/newspapers
MIN_EXTRACTABLE_CHARS=200
ENABLE_OCR=true
OCR_LANGUAGES=eng+hin
OCR_DPI=200

# Logging
LOG_LEVEL=INFO
